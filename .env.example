# Copie ce fichier en .env et renseigne tes valeurs.

# Jeton du bot Telegram, obtenu auprès de @BotFather (obligatoire)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Clé API Anthropic, depuis https://console.anthropic.com (obligatoire)
ANTHROPIC_API_KEY=sk-ant-...

# Chat IDs autorisés, séparés par des virgules (fortement recommandé).
# Sans cette variable, le bot répond à TOUT LE MONDE.
# Ton chat ID s'affiche si tu écris au bot sans être autorisé.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Optionnel ---
# Modèle Claude (défaut : claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
# Raisonnement étendu : "adaptive" (plus intelligent) ou "disabled" (plus rapide, défaut)
# THINKING=disabled
# Racine des fichiers accessibles (défaut : dossier courant)
# KNOWLEDGE_ROOT=.
# Nombre max de tokens par réponse (défaut : 2048)
# MAX_TOKENS=2048
